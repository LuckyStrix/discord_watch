# Copy to .env and fill in. .env is gitignored -- never commit your token.

# Your Discord *user* token (see README: "Getting your token"). Anyone with this
# has full access to your account, so treat it like a password.
DISCORD_TOKEN=

DB_PASSWORD=change-me
# DB_USER=watch
# DB_NAME=discord_watch
# DB_DATA_LOCATION=./postgres-data

# Ollama runs natively on the host, shared with other projects.
# OLLAMA_BASE_URL=http://host.docker.internal:11434

# Host port for the dashboard.
# WEB_PORT=8095
